# Base section options
KERNEL_SOURCE=https://github.com/a03corerooted-dev-ctrl/Hysteris_kernel_xiaomi_mt6768
KERNEL_SOURCE_BRANCH=experimental/combo-lru-reclaim
# Pin the exact kernel revision under test; update only after source audit.
KERNEL_SOURCE_EXPECTED_SHA=1e6934384726ce01f4f460b01d12358602ae37e9
KERNEL_ARCH=arm64
KERNEL_IMAGE_NAME=Image.gz-dtb

# 4.19 config layout: common base + device-specific fragment
# Enable strict ZRAM multicomp + automatic recompression source/config/object auditing.
ZRAM_MULTICOMP_AUDIT=true
BORE_SCHEDULER=true
SPECULATIVE_PAGE_FAULT=true
KERNEL_CONFIG_BASE=vendor/mt6768_defconfig
KERNEL_CONFIG_FRAGMENT_DIR=vendor

# KernelSU section options
ENABLE_KERNELSU=true
KERNELSU_SETUP_SOURCE=https://raw.githubusercontent.com/MrShockWAVEog/KernelSU/shockwave/kernel/setup.sh
KERNELSU_TAG=shockwave
ADD_KPROBES_CONFIG=true
KSU_HOOKS_PATCH=false # Use KernelSU's native ARM64 hooks; legacy patch targets a different kernel layout
KSU_REVERT=false
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# APatch section options
ADD_APATCH_SUPPORT=true
FIX_APATCH_OPENELA=false # Hysteris already has the atomic_t and get_task_cred implementations; legacy patch is redundant

# Compiler section options
USE_CLANG=true
CLANG_SOURCE=https://github.com/Neutron-Toolchains/clang-build-catalogue/releases/download/06092026/neutron-clang-06092026.tar.zst
CLANG_BRANCH=
USE_GCC=false
USE_GCC_64=false
GCC_64_SOURCE=https://snapshots.linaro.org/gnu-toolchain/14.0-2023.06-1/aarch64-linux-gnu/gcc-linaro-14.0.0-2023.06-x86_64_aarch64-linux-gnu.tar.xz
GCC_64_BRANCH=
USE_GCC_32=false
GCC_32_SOURCE=https://snapshots.linaro.org/gnu-toolchain/14.0-2023.06-1/arm-linux-gnueabihf/gcc-linaro-14.0.0-2023.06-x86_64_arm-linux-gnueabihf.tar.xz
GCC_32_BRANCH=

# Anykernel3 section options
USE_ANYKERNEL3=true
ANYKERNEL3_SOURCE=https://github.com/a03corerooted-dev-ctrl/AnyKernel3.git
ANYKERNEL3_BRANCH=Hysteris

# Build section options
EXTRA_CMDS=LLVM=1 LLVM_IAS=1 CROSS_COMPILE=aarch64-linux-gnu- CROSS_COMPILE_ARM32=arm-linux-gnueabi- CROSS_COMPILE_COMPAT=arm-linux-gnueabi- CONFIG_NO_ERROR_ON_MISMATCH=y TARGET_BUILD_VARIANT=user
DISABLE_LTO=
DISABLE_CC_WERROR=
ENABLE_PYTHON2=false
ENABLE_CCACHE=false
REMOVE_UNUSED_PACKAGES=false
NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=https://raw.githubusercontent.com/xiaoleGun/KernelSU_action/main/boot/boot.img

# Misc section options
ADD_OVERLAYFS_CONFIG=false

# Proton specific section options
FIX_WIFI_SPEED=false

# FOR KPM
KPM_SUPPORT=false
KPM_URL=https://github.com/SukiSU-Ultra/SukiSU_KernelPatch_patch/releases/download/0.12.2/patch_linux
